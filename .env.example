ANTHROPIC_API_KEY=your_anthropic_api_key_here

# PostgreSQL — leave blank to use in-memory store
# Railway: copy from your Postgres addon's "DATABASE_URL" variable
DATABASE_URL=

# Locus (Paygentic) — leave blank to run in mock mode
LOCUS_API_KEY=
LOCUS_WEBHOOK_SECRET=

# Public URL of this server (needed for Locus redirect URLs)
# Use ngrok for local testing: https://your-id.ngrok.io
BASE_URL=http://localhost:3000

PORT=3000
